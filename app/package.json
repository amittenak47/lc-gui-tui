{
  "name": "lc-whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Handwriting whiteboard coach for the lc harness — Tauri v2 shell around an Excalidraw canvas, talking to `lc serve` over the LAN.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/android-overlay.mjs",
    "android:overlay": "node scripts/android-overlay.mjs",
    "android:dev": "node scripts/android-overlay.mjs && tauri android dev",
    "android:apk": "node scripts/android-overlay.mjs && tauri android build --apk --debug",
    "android:apk:release": "node scripts/android-overlay.mjs && tauri android build --apk",
    "icons:sync": "tauri icon ../docs/icons/tauri.manifest.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}

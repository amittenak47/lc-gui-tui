{
  "name": "whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Handwriting whiteboard — Tauri v2 shell around an Excalidraw canvas. Desktop and APK embed the harness router (no lc serve, no LAN pairing).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/android-overlay.mjs && npm run icons:sync",
    "android:overlay": "node scripts/android-overlay.mjs",
    "android:dev": "node scripts/android-overlay.mjs && npm run icons:sync && node scripts/android-with-jdk.mjs tauri android dev",
    "android:apk:practice": "node scripts/android-overlay.mjs && npm run icons:sync && node scripts/android-with-jdk.mjs tauri android build --apk --debug --target aarch64",
    "android:apk:practice:release": "node scripts/android-overlay.mjs && npm run icons:sync && node scripts/android-with-jdk.mjs tauri android build --apk",
    "android:apk:whiteboard": "node scripts/android-apk-whiteboard.mjs --debug",
    "android:apk:whiteboard:release": "node scripts/android-apk-whiteboard.mjs",
    "android:apk": "npm run android:apk:practice",
    "android:apk:release": "npm run android:apk:practice:release",
    "android:apk:pads": "npm run android:apk:whiteboard",
    "android:apk:pads:release": "npm run android:apk:whiteboard:release",
    "logs:android": "node scripts/android-adb-wireless.mjs logcat",
    "logs:open": "node scripts/android-adb-wireless.mjs logcat open",
    "logs:clear": "node scripts/android-adb-wireless.mjs logcat clear",
    "adb:pair": "node scripts/android-adb-wireless.mjs pair",
    "adb:connect": "node scripts/android-adb-wireless.mjs connect",
    "adb:reconnect": "node scripts/android-adb-wireless.mjs reconnect",
    "adb:devices": "node scripts/android-adb-wireless.mjs devices",
    "android:wireless:practice": "node scripts/android-adb-wireless.mjs install practice",
    "android:wireless:whiteboard": "node scripts/android-adb-wireless.mjs install whiteboard",
    "icons:sync": "tauri icon ../docs/icons/tauri.manifest.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "motion": "^13.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default, and `lc serve` in LAN mode speaks plain
  HTTP on the local network.

  NOTE: <domain> entries only match hostnames — CIDR strings like 192.168.0.0/16 are
  silently ignored. That is why Chrome on the tablet could open /health while the
  WebView fetch for /pair failed until this was fixed.

  The APK also proxies HTTP through Rust (lc_request) as a second line of defence.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

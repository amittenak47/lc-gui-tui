<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default.

  The harness router is in-process (lc_dispatch) — this overlay is not for LAN
  daemon pairing. It allows the WebView to fetch cleartext http:// pages in
  Annotate mode (external document URLs).

  NOTE: <domain> entries only match hostnames — CIDR strings like 192.168.0.0/16 are
  silently ignored.

  The APK also fetches http(s) pages from Rust (`fetch_html`) for Annotate.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

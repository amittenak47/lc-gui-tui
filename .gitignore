# --- Rust ---
/target/
/app/src-tauri/target/
/app/src-tauri/plugins/*/target/

# --- Whiteboard app (app/) ---
node_modules/
/app/dist/
# Generated by `tauri android init`; the parts worth keeping live in
# app/src-tauri/android-overlay/.
/app/src-tauri/gen/
/app/src-tauri/plugins/*/android/build/
/app/src-tauri/plugins/*/android/.tauri/
*.tsbuildinfo
vite.config.ts.timestamp-*

# --- Generated practice workspaces ---
# Default workspace is ~/lc-workspace; on Windows a mistaken path can create this folder:
$HOME/
lc-workspace/

# Python artifacts from generated problem workspaces
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Secrets & local config (normally lives in OS config dir) ---
.env
.env.*
!.env.example
config.toml
*.local.toml
secrets.*

# --- SQLite / session state (if copied into the repo) ---
*.db
*.db-journal
*.db-wal
*.db-shm
session.json
last_run.json

# --- IDE ---
.idea/
*.iml
/.vscode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & coverage ---
*.log
coverage/
htmlcov/
.coverage

# --- Misc tooling ---
.mimicflow/

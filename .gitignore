# --- Rust ---
/target/
/app/src-tauri/target/
/app/src-tauri/plugins/*/target/

# --- Whiteboard app (app/) ---
node_modules/
/app/dist/
# pdf.js cmaps and fonts, copied in by the build — vendored output, not source.
/dist/
# Generated by `tauri android init`; the parts worth keeping live in
# app/src-tauri/android-overlay/.
/app/src-tauri/gen/
/app/src-tauri/plugins/*/android/build/
/app/src-tauri/plugins/*/android/.tauri/
/app/src-tauri/plugins/*/permissions/
*.tsbuildinfo
vite.config.ts.timestamp-*

# --- Local problem corpora (downloaded JSON/JSONL; not versioned) ---
/data/
/app/src-tauri/resources/corpora/*.zip
/dist/dlc/

# --- Generated practice workspaces ---
# Default workspace is ~/lc-workspace; on Windows a mistaken path can create this folder:
$HOME/
lc-workspace/

# Python artifacts from generated problem workspaces
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# --- Secrets & local config (normally lives in OS config dir) ---
.env
.env.*
!.env.example
config.toml
*.local.toml
secrets.*

# --- SQLite / session state (if copied into the repo) ---
*.db
*.db-journal
*.db-wal
*.db-shm
session.json
last_run.json

# --- IDE ---
.idea/
*.iml
/.vscode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & coverage ---
*.log
coverage/
htmlcov/
.coverage
audit-*.jsonl
# `audit_tests --resume` writes a sidecar beside the report; the pattern above
# anchors to the end of the name and never matched it.
audit-*.jsonl.progress.json

# --- Misc tooling ---
.mimicflow/
.tmp-unix/
.tmp-frames/

# Accidental build outDir under the source tree — a `vite build` run from a
# subdirectory drops pdf.js cmaps and fonts wherever it was invoked.
/app/src/modes/dist/
/app/src/**/dist/

# Cargo vendor/patch stamp — not a source file
**/.cargo-ok

# --- Local / agent docs (not shipped; ingest from docs/fix-log/) ---
# Nothing under docs/ ships except docs/icons/, which is build input for
# `npm run icons:sync`. Markdown is matched at every depth, not just the top
# level, so a backup or a subfolder cannot quietly become tracked.
docs/*.md
docs/**/*.md
docs/fix-log/
docs/plans/
docs/backup-*/
